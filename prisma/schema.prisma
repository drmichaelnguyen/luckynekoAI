generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  /// Optional name the assistant uses in chat (falls back to name, then email local-part).
  nickname     String?
  /// Relative path under avatar storage root, e.g. `{userId}/avatar.jpg`
  avatarRelativePath String?
  /// "user" | "admin"
  role                String  @default("user")
  /// false until the user finishes first-run onboarding (new accounts set explicitly).
  onboardingCompleted Boolean @default(true)
  /// Primary reporting currency for wallets & chat context.
  preferredCurrency   String  @default("CAD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallets          Wallet[]
  categories       Category[]
  transactions     Transaction[]
  recurrentSeries  RecurrentSeries[]
  importBatches    ImportBatch[]
  storedMedia      StoredMedia[]
  financialPlans   FinancialPlan[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

enum PlanKind {
  spending_budget
  savings_goal
}

enum PlanPeriod {
  none
  weekly
  monthly
  yearly
}

/// User-defined spending caps and savings targets for chat context and personal planning.
model FinancialPlan {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          PlanKind
  title         String
  description   String?
  /// Spending: max per `period` in minor units; savings: target amount in minor units (nullable = qualitative only).
  amountCents   Int?
  currency      String     @default("CAD")
  period        PlanPeriod @default(none)
  targetDate    DateTime?
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
}

/// Saved bytes for chat uploads (receipts, paystubs, images). Paths are under local MEDIA_STORAGE_DIR.
model StoredMedia {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  mimeType           String
  originalFilename   String
  byteSize           Int
  sha256             String
  /// Relative to media storage root, e.g. `{userId}/{id}.pdf`
  relativePath       String
  source             String   @default("chat")
  /// Groups files from one chat submission.
  chatTurnId         String?
  documentKind       String?
  transactionId      String?
  /// When true, user allows this asset to be used in future model training / fine-tuning (off by default).
  trainingOptIn      Boolean  @default(false)
  /// Small JSON snapshot of extracted labels for training pipelines (not full model output).
  structuredExcerpt  String?
  /// When set, user has not yet chosen ADD vs EDIT for this chat turn’s financial document import.
  pendingImportJson String?
  /// Original vs user-corrected extraction bundle for optional training export (set on EDIT path).
  trainingExampleJson String?
  /// True when user corrected extraction before saving (pairs with trainingExampleJson).
  markedForTraining   Boolean @default(false)

  @@index([userId, createdAt])
  @@index([chatTurnId])
  @@index([transactionId])
}

enum WalletKind {
  spending
  savings
  credit
  other
}

model Wallet {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      WalletKind @default(spending)
  currency  String     @default("CAD")
  isDefault Boolean    @default(false)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  transactions    Transaction[]
  recurrentSeries RecurrentSeries[]

  @@index([userId])
}

enum CategoryKind {
  income
  expense
  transfer
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  kind      CategoryKind @default(expense)
  parentId  String?
  parent    Category?    @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]   @relation("CategoryChildren")
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions    Transaction[]
  recurrentSeries RecurrentSeries[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, parentId])
}

enum FlowDirection {
  in
  out
}

enum TxRecurrence {
  one_time
  recurrent
}

enum TxStatus {
  draft
  pending_user
  posted
  rejected
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  amountCents   Int
  direction     FlowDirection
  currency      String        @default("CAD")
  merchant      String?
  memo          String?
  occurredAt    DateTime
  recurrence    TxRecurrence    @default(one_time)
  status        TxStatus        @default(posted)
  confirmReason String?

  recurrentSeriesId String?
  recurrentSeries   RecurrentSeries? @relation(fields: [recurrentSeriesId], references: [id], onDelete: SetNull)

  source            String  @default("chat")
  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  rawStructuredJson String?
  /// JSON array of edit snapshots: [{editedAt, before, after, editedBy}]
  editHistoryJson   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([walletId])
  @@index([importBatchId])
}

enum RecurrentCadence {
  weekly
  monthly
  yearly
  irregular
}

model RecurrentSeries {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId       String
  wallet         Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label          String
  cadence        RecurrentCadence @default(monthly)
  amountCents    Int
  direction      FlowDirection
  nextReminderAt DateTime?
  isPaused       Boolean          @default(false)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  transactions Transaction[]

  @@index([userId])
}

model ImportBatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  rowCount  Int
  status    String   @default("completed")
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([userId])
}
