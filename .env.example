# Google AI Studio / Gemini API key
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional override (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Auth — required for sign-up and sign-in (generate with: openssl rand -base64 32)
AUTH_SECRET=
# App URL (e.g. http://localhost:3200) — set in production for correct links
AUTH_URL=http://localhost:3200

# SQLite database (path relative to prisma/schema.prisma → prisma/dev.db)
DATABASE_URL="file:./dev.db"
