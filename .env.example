# Google AI Studio / Gemini API key
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional override (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional GPT-compatible model router target. The app uses it first for
# text-heavy reasoning/cleanup and as fallback when Gemini returns bad output.
# NINE_ROUTER_API_KEY=your_9router_key_here
# NINE_ROUTER_URL=https://9router.k-aithelittlelion.com/v1/chat/completions
# NINE_ROUTER_MINI_MODEL=gpt-5
# NINE_ROUTER_MODEL=gpt-5
# Abort slow 9router calls before Cloudflare/proxy timeouts (milliseconds, default 45000).
# NINE_ROUTER_FETCH_TIMEOUT_MS=45000

# Auth — required for sign-up and sign-in (generate with: openssl rand -base64 32)
AUTH_SECRET=
# App URL (e.g. http://localhost:3200) — set in production for correct links
AUTH_URL=http://localhost:3200

# SMTP for password reset emails. Cloudflare can host your domain/DNS, but you still need
# an outbound mail provider or mailbox SMTP credentials for that domain.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="NekoZeni <no-reply@yourdomain.com>"

# SQLite database (path relative to prisma/schema.prisma → prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Optional: directory for saved chat images/PDFs (default: ./storage/user-media under the app root)
# MEDIA_STORAGE_DIR=

# Shared secret for AGENTS -> LuckyNeko integration APIs
INTEGRATION_SHARED_SECRET=

# Optional local harness defaults for `npm run agent:harness`
# AGENT_HARNESS_BASE_URL=http://localhost:3200
# AGENT_HARNESS_USER_ID=
# AGENT_HARNESS_USER_EMAIL=
